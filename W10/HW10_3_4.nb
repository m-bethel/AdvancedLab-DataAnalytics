Cell[BoxData[{
 RowBox[{
  RowBox[{"vfit", "=", 
   RowBox[{"LinearModelFit", "[", 
    RowBox[{"vdata", ",", "V", ",", "V"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"vfit", "[", "\"\<ParameterTable\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vfitplot", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"vfit", "[", "X", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"X", ",", 
       RowBox[{"Min", "[", "t", "]"}], ",", 
       RowBox[{"Max", "[", "t", "]"}]}], "}"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Black"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dvplot", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"xfit", "[", "X", "]"}], ",", "X"}], "]"}], "/.", 
       RowBox[{"X", "->", "T"}]}], ")"}], ",", 
     RowBox[{"{", 
      RowBox[{"T", ",", 
       RowBox[{"Min", "[", "t", "]"}], ",", 
       RowBox[{"Max", "[", "t", "]"}]}], "}"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"vfitplot", ",", "vplot", ",", " ", "dvplot"}], "]"}]}], "Input",
