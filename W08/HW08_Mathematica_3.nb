Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"lambda", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"740", ",", "780", ",", "1"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"i", "=", 
     RowBox[{"{", 
      RowBox[{
      "0.277", ",", "0.275", ",", "0.273", ",", "0.271", ",", "0.269", ",", 
       "0.266", ",", "0.263", ",", "0.259", ",", "0.256", ",", "0.252", ",", 
       "0.248", ",", "0.244", ",", "0.240", ",", "0.237", ",", "0.232", ",", 
       "0.222", ",", "0.202", ",", "0.179", ",", "0.159", ",", "0.138", ",", 
       "0.120", ",", "0.105", ",", "0.099", ",", "0.107", ",", "0.119", ",", 
       "0.131", ",", "0.143", ",", "0.154", ",", "0.161", ",", "0.166", ",", 
       "0.166", ",", "0.165", ",", "0.163", ",", "0.160", ",", "0.158", ",", 
       "0.155", ",", "0.152", ",", "0.149", ",", "0.146", ",", "0.144", ",", 
       "0.141"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"data", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"lambda", ",", " ", "i"}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", 
     RowBox[{"model", ":", 
      RowBox[{
       RowBox[{"Linear", " ", "Background"}], "-", 
       RowBox[{"Gaussian", " ", "Dip"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"model", "=", 
     RowBox[{
      RowBox[{"m", "*", "x"}], "+", "b", "-", 
      RowBox[{"h", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"x", "-", "mu"}], ")"}], "2"]}], "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", 
           SuperscriptBox["sigma", "2"]}], ")"}]}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Perform", " ", "the", " ", "fit", " ", "with", " ", "initial", " ", 
     "guesses"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nlm", "=", 
     RowBox[{"NonlinearModelFit", "[", 
      RowBox[{"data", ",", "model", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"-", "0.003"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"b", ",", "2.5"}], "}"}], ",", 
         RowBox[{"{", 
