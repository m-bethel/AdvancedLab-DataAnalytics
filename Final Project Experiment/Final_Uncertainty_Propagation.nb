Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"1.", " ", "Constants"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"q", "=", 
     RowBox[{"1.602", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "19"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"c", "=", "299792458"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"mAccepted", "=", 
     RowBox[{"9.109", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "31"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"2.", " ", "Input", " ", "Parameters"}], "&"}], " ", 
     "Uncertainties"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Format", ":", 
     RowBox[{"Around", "[", 
      RowBox[{"nominal_value", ",", "uncertainty"}], "]"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"y", "=", 
     RowBox[{"Around", "[", 
      RowBox[{"0.037", ",", "0.001"}], "]"}]}], ";"}], "       ", 
   RowBox[{"(*", 
    RowBox[{"Deflection", " ", "in", " ", "m"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"volts", "=", 
     RowBox[{"Around", "[", 
      RowBox[{"975", ",", "5"}], "]"}]}], ";"}], "          ", 
   RowBox[{"(*", 
    RowBox[{"Voltage", " ", "in", " ", "V"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"B", "=", 
     RowBox[{"Around", "[", 
      RowBox[{"0.00448", ",", "0.0001"}], "]"}]}], ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{"Magnetic", " ", "Field", " ", "in", " ", "T"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"d", "=", 
     RowBox[{"Around", "[", 
      RowBox[{"0.001", ",", "0.00001"}], "]"}]}], ";"}], "      ", 
   RowBox[{"(*", 
    RowBox[{"Capacitor", " ", "Gap", " ", "in", " ", "m"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Lf", "=", 
     RowBox[{"Around", "[", 
      RowBox[{"0.115", ",", "0.005"}], "]"}]}], ";"}], "        ", 
   RowBox[{"(*", 
    RowBox[{"Field", " ", "Length", " ", "in", " ", "m"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Lt", "=", 
     RowBox[{"Around", "[", 
      RowBox[{"0.18", ",", "0.002"}], "]"}]}], ";"}], "        ", 
   RowBox[{"(*", 
    RowBox[{"Total", " ", "Length", " ", "in", " ", "m"}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "The", " ", "Math", " ", 
     RowBox[{"(", 
      RowBox[{"Error", " ", "propagates", " ", 
       RowBox[{"automatically", "!"}]}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"R", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Lf", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "*", "Lt"}], "-", "Lf"}], ")"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", "*", "y"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"v", "=", 
     RowBox[{"volts", "/", 
      RowBox[{"(", 
       RowBox[{"B", "*", "d"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gamma", "=", 
     RowBox[{"1", "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"v", "/", "c"}], ")"}], "^", "2"}]}], "]"}]}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"mExp", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"q", "*", "B", "*", "R"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"gamma", "*", "v"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"4.", " ", "Calculations", " ", "for", " ", "Z"}], "-", 
     "Score"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"diff", "=", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"mExp", "[", "\"\<Value\>\"", "]"}], "-", "mAccepted"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"zScore", "=", 
     RowBox[{"diff", "/", 
      RowBox[{"mExp", "[", "\"\<Uncertainty\>\"", "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"5.", " ", "Output"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Calculated Radius (m): \>\"", ",", "R"}], "]"}], "\n", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Calculated Velocity (m/s): \>\"", ",", "v"}], "]"}], "\n", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Experimental Mass (kg): \>\"", ",", "mExp"}], "]"}], "\n", 
   RowBox[{"Print", "[", "\"\<\>\"", "]"}], "\n", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Accepted Mass (kg): \>\"", ",", "mAccepted"}], "]"}], "\n", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Difference from true: \>\"", ",", "diff"}], "]"}], "\n", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Z-Score (sigma): \>\"", ",", "zScore"}], "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.984607160187234*^9, 3.984607183289953*^9}, {
