         RowBox[{"[", "i", "]"}], "]"}]}], ")"}], 
      RowBox[{"2", "*", "0.2"}]], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{
        RowBox[{"Length", "[", "VcVals", "]"}], "-", "2"}]}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t2", "=", 
